<?xml version="1.0" encoding="utf-8"?>
<grid name="proximalTubuleBloodVessel">
	<!-- Simplified 2D cross-section of an artificial proximal tubule next to a blood vessel.
	     Dimensions are represented in meters: nephron lumen = 10 um, nephron membrane = 1 um,
	     interstitium = 5 um, blood membrane = 1 um, and blood lumen = 5 um. -->
	<vertices coords="3">
		0 0 0
		1e-4 0 0
		1.1e-4 0 0
		1.6e-4 0 0
		1.7e-4 0 0
		2.2e-4 0 0
		0 1e-4 0
		1e-4 1e-4 0
		1.1e-4 1e-4 0
		1.6e-4 1e-4 0
		1.7e-4 1e-4 0
		2.2e-4 1e-4 0
	</vertices>
	<edges>0 1 1 2 2 3 3 4 4 5 6 7 7 8 8 9 9 10 10 11 0 6 5 11 1 7 2 8 3 9 4 10</edges>
	<quadrilaterals>0 1 7 6 1 2 8 7 2 3 9 8 3 4 10 9 4 5 11 10</quadrilaterals>
	<subset_handler name="defSH">
		<subset name="NephronLumen" color="0.2 0.6 1.0 1" state="393216">
			<faces>0</faces>
		</subset>
		<subset name="NephronMembrane" color="0.9 0.6 0.2 1" state="393216">
			<faces>1</faces>
		</subset>
		<subset name="Interstitium" color="0.3 0.8 0.3 1" state="393216">
			<faces>2</faces>
		</subset>
		<subset name="BloodMembrane" color="0.8 0.3 0.8 1" state="393216">
			<faces>3</faces>
		</subset>
		<subset name="BloodLumen" color="0.9 0.2 0.2 1" state="393216">
			<faces>4</faces>
		</subset>
		<subset name="ApicalMembrane" color="1 0.3 0.3 1" state="393216">
			<edges>1</edges>
		</subset>
		<subset name="BasolateralMembrane" color="0.3 1 0.3 1" state="393216">
			<edges>2</edges>
		</subset>
		<subset name="BloodInterface" color="0.3 0.3 1 1" state="393216">
			<edges>3</edges>
		</subset>
	</subset_handler>
	<subset_handler name="markSH">
		<subset name="crease" color="1 1 1 1" state="0"/>
		<subset name="fixed" color="1 1 1 1" state="0"/>
	</subset_handler>
	<selector name="defSel"/>
</grid>
