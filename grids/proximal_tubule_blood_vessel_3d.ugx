<?xml version="1.0" encoding="utf-8"?>
<grid name="proximalTubuleBloodVessel3D">
	<!-- Simplified 3D geometry: a proximal tubule and adjacent blood vessel represented as blocks.
	     Dimensions in meters: nephron lumen diameter ~10 um, membrane thickness ~1 um,
	     blood vessel diameter ~5 um. -->
	<vertices coords="3">
		0 0 0
		1e-4 0 0
		1.1e-4 0 0
		1.6e-4 0 0
		1.7e-4 0 0
		2.2e-4 0 0
		0 1e-4 0
		1e-4 1e-4 0
		1.1e-4 1e-4 0
		1.6e-4 1e-4 0
		1.7e-4 1e-4 0
		2.2e-4 1e-4 0
		0 0 1e-4
		1e-4 0 1e-4
		1.1e-4 0 1e-4
		1.6e-4 0 1e-4
		1.7e-4 0 1e-4
		2.2e-4 0 1e-4
		0 1e-4 1e-4
		1e-4 1e-4 1e-4
		1.1e-4 1e-4 1e-4
		1.6e-4 1e-4 1e-4
		1.7e-4 1e-4 1e-4
		2.2e-4 1e-4 1e-4
	</vertices>
	<edges>0 1 1 2 2 3 3 4 4 5 6 7 7 8 8 9 9 10 10 11 0 6 5 11 1 7 2 8 3 9 4 10 12 13 13 14 14 15 15 16 16 17 18 19 19 20 20 21 21 22 22 23 12 18 17 23 13 19 14 20 15 21 16 22</edges>
	<hexahedra>0 1 7 6 12 13 19 18 1 2 8 7 13 14 20 19 2 3 9 8 14 15 21 20 3 4 10 9 15 16 22 21 4 5 11 10 16 17 23 22</hexahedra>
	<subset_handler name="defSH">
		<subset name="NephronLumen" color="0.2 0.6 1.0 1" state="393216">
			<hexahedra>0</hexahedra>
		</subset>
		<subset name="NephronMembrane" color="0.9 0.6 0.2 1" state="393216">
			<hexahedra>1</hexahedra>
		</subset>
		<subset name="Interstitium" color="0.3 0.8 0.3 1" state="393216">
			<hexahedra>2</hexahedra>
		</subset>
		<subset name="BloodMembrane" color="0.8 0.3 0.8 1" state="393216">
			<hexahedra>3</hexahedra>
		</subset>
		<subset name="BloodLumen" color="0.9 0.2 0.2 1" state="393216">
			<hexahedra>4</hexahedra>
