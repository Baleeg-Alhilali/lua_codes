+// Opt-in: pass double-precision coordinates to TetGen when the environment
+// variable UG_TETGEN_DOUBLE_PRECISION is set to a non-zero value.  The default
+// float cast (see comment below) is kept for backward compatibility; it rounds
+// millimetre coordinates by up to ~3e-8 relative, which is significant for
+// micrometre-scale features.
+static bool TetgenUseDoublePrecision()
+{
+	static const bool use = [] {
+		const char* v = std::getenv("UG_TETGEN_DOUBLE_PRECISION");
+		return v != NULL && v[0] != '\0' && v[0] != '0';
+	}();
+	return use;
+}
+
+// Opt-in minimum dihedral angle (degrees) for TetGen's quality refinement,
+// read from UG_TETGEN_MIN_DIHEDRAL; returns "" when unset.  Appended to the
+// radius-edge bound as "/<angle>" so TetGen also removes slivers.
+static std::string TetgenMinDihedralSuffix()
+{
+	const char* v = std::getenv("UG_TETGEN_MIN_DIHEDRAL");
+	if (v == NULL || v[0] == '\0') return std::string();
+	const double angle = std::atof(v);
+	if (angle <= 0.0) return std::string();
+	std::stringstream ss;
+	ss << "/" << angle;
+	return ss.str();
+}
