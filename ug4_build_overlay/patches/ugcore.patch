+	template <typename TBF, typename TVelocity>
+	auto unit_normal_velocity(const TBF& bf, const TVelocity& velocity, int)
+		-> decltype(bf.normal(), number())
+	{
+		const number area = VecLength(bf.normal());
+		UG_COND_THROW(area <= 0.0,
+			"FV1InnerBoundaryElemDisc: zero boundary-face measure.");
+		return VecDot(velocity, bf.normal()) / area;
+	}
+
+	template <typename TBF>
+	number unit_normal_velocity(const TBF& bf,
+	                            const MathVector<3>& velocity, long)
+	{
+		UG_COND_THROW(bf.num_corners() < 3,
+			"FV1InnerBoundaryElemDisc: at least three manifold boundary-face "
+			"corners are required to construct a 3-D normal.");
+		MathVector<3> edgeOne;
+		MathVector<3> edgeTwo;
+		MathVector<3> normal;
+		VecSubtract(edgeOne, bf.global_corner(1), bf.global_corner(0));
+		VecSubtract(edgeTwo, bf.global_corner(2), bf.global_corner(0));
+		VecCross(normal, edgeOne, edgeTwo);
+		const number areaScale = VecLength(normal);
+		UG_COND_THROW(areaScale <= 0.0,
+			"FV1InnerBoundaryElemDisc: degenerate manifold boundary face.");
+		return VecDot(velocity, normal) / areaScale;
+	}
+
+	template <typename TBF, typename TVelocity>
+	number unit_normal_velocity(const TBF&, const TVelocity&, long)
+	{
+		UG_THROW("FV1InnerBoundaryElemDisc: normal-velocity flux scaling is "
+			"not available for this manifold boundary-face geometry.");
+	}
+}
